{
  "name": "@extension/editor",
  "version": "0.5.27",
  "description": "Shared screenshot annotation editor with isolated sessions",
  "type": "module",
  "private": true,
  "sideEffects": true,
  "files": [
    "dist/**"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "ready": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@extension/env": "workspace:*",
    "@extension/i18n": "workspace:*",
    "@extension/shared": "workspace:*",
    "@extension/storage": "workspace:*",
    "@extension/ui": "workspace:*",
    "fabric": "6.6.7",
    "file-saver": "^2.0.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*",
    "@types/file-saver": "^2.0.7"
  }
}
